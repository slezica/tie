{
  "name": "tie",
  "version": "0.1.0",
  "description": "Tiled Integrated Environment",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "install-electron && electron-rebuild -f -w node-pty,tie-peer && dev/brand-electron.sh"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@mermaid-js/tiny": "12.2.0",
    "@types/node": "24.19.2",
    "dompurify": "3.4.17",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "morphdom": "2.7.8",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "tie-peer": "file:native/peer"
  },
  "author": "salezica"
}
