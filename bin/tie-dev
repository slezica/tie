#!/usr/bin/env bash
# tie-dev: development toolkit for Tie.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
tie-dev - Tie development toolkit

Usage: tie-dev [--instance NAME] <command> [args]

Commands:
  run [--hot]              Run in foreground; --hot: dev server, UI hot-reloads on change
  build                    Build to out/
  start                    Build if needed, launch app in background
  stop                     Stop instance
  status                   Show instance info (pid, socket, debug port)
  logs [-f]                Show instance log (enable tags with TIE_DEBUG=layout,shelf,pty,rpc or *)
  test --unit              Unit tests (vitest)
  test --e2e               Run every scenario in dev/scenarios on fresh instances
  typecheck                tsc --noEmit
  layout                   ASCII render of the board
  screenshot [file]        PNG of current state (default tmp/shots/current.png)
  drive <scenario|-> [--attach] [--keep]
                           Run Playwright scenario (file in dev/scenarios, path, or - for stdin).
                           Fresh instance by default; --attach uses running instance;
                           --keep leaves fresh instance running.
  scenarios                List scenarios
  package                  Build out/package/mac-arm64/Tie.app (arm64, signed ad hoc)
  release --version X.Y.Z  Clean repo, all checks, bump + commit version, tag vX.Y.Z, package
  install                  Package, then install to /Applications/Tie.app (Tie must not be running)
  icon                     Re-render placeholder icon (build/icon.png, build/icon.icns)

Instance: --instance NAME (or =NAME, anywhere) or TIE_INSTANCE (default "dev"; the installed app is "default"). Each instance has its own
socket, lock, debug port, log under ~/.config/tie/.
EOF
}

# --instance NAME (or --instance=NAME) may appear anywhere (e.g. `tie-dev stop --instance x`);
# never fall back silently.
args=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--instance" ]]; then
    [[ -n "${2:-}" ]] || { echo "--instance needs a name"; exit 1; }
    export TIE_INSTANCE="$2"
    shift 2
  elif [[ "$1" == --instance=* ]]; then
    [[ -n "${1#--instance=}" ]] || { echo "--instance needs a name"; exit 1; }
    export TIE_INSTANCE="${1#--instance=}"
    shift
  elif [[ "$1" == --instance* ]]; then
    echo "unknown option: $1"; exit 1
  else
    args+=("$1")
    shift
  fi
done
set -- "${args[@]+"${args[@]}"}"
export TIE_INSTANCE="${TIE_INSTANCE:-dev}"
STATE="${XDG_CONFIG_HOME:-$HOME/.config}/tie"
mkdir -p "$STATE/log"
INFO="$STATE/$TIE_INSTANCE.json"
LOG="$STATE/log/$TIE_INSTANCE.log"

# Stamp written only by full builds: `tie-dev run` (dev server) rewrites out/main but not out/renderer.
# Trace: every invocation is logged; scenario runs leave a folder each (see docs/HARNESS.md).
LOGDIR="$ROOT/out/log"
RUNS="$LOGDIR/runs"
mkdir -p "$RUNS"
T0=$(date +%s)
CMDLINE="$*"
echo "$(date '+%F %T') start [$TIE_INSTANCE] tie-dev $CMDLINE" >> "$LOGDIR/tie-dev.log"
trap 'code=$?; echo "$(date "+%F %T") end   [$TIE_INSTANCE] tie-dev $CMDLINE exit=$code $(( $(date +%s) - T0 ))s" >> "$LOGDIR/tie-dev.log"' EXIT
# Keep the newest 50 run folders.
{ ls -1dt "$RUNS"/*/ 2>/dev/null || true; } | tail -n +51 | while read -r d; do rm -rf "$d"; done

STAMP=out/.build-stamp
APP_OUT=out/package/mac-arm64/Tie.app
needs_build() {
  [[ ! -f "$STAMP" ]] && return 0
  [[ -n "$(find src electron.vite.config.ts package.json package-lock.json -newer "$STAMP" -type f | head -1)" ]]
}

# Content hash of everything that goes into Tie.app. Stored in the bundle (Resources/fingerprint)
# so package/install can tell whether anything changed.
PKG_INPUTS=(src bin/tie resources build electron-builder.yml electron.vite.config.ts package.json package-lock.json)
fingerprint() { find "${PKG_INPUTS[@]}" -type f -print0 | sort -z | xargs -0 shasum | shasum | cut -c1-16; }
bundle_fp() { cat "$1/Contents/Resources/fingerprint" 2>/dev/null; }

build() { npx electron-vite build >/dev/null && touch "$STAMP"; }

# Debug port nobody listens on now (per-name hashed ports can collide); the info file records it.
free_port() { node -e "const s=require('net').createServer();s.listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close()})"; }

cmd="${1:-}"
shift || true
case "$cmd" in
  run)
    export TIE_DEBUG_PORT="${TIE_DEBUG_PORT:-$(free_port)}"
    if [[ "${1:-}" == "--hot" ]]; then exec npx electron-vite dev; fi
    if needs_build; then build; fi
    exec node_modules/electron/dist/Electron.app/Contents/MacOS/Electron . ;;
  build)
    npx electron-vite build && touch "$STAMP" ;;
  start)
    if needs_build; then build; fi
    if [[ -f "$INFO" ]] && kill -0 "$(node -p "require('$INFO').pid")" 2>/dev/null; then
      echo "instance $TIE_INSTANCE already running"; exit 0
    fi
    export TIE_DEBUG_PORT="${TIE_DEBUG_PORT:-$(free_port)}"
    nohup node_modules/electron/dist/Electron.app/Contents/MacOS/Electron . -ApplePersistenceIgnoreState YES >>"$LOG" 2>&1 &
    for _ in $(seq 1 100); do [[ -f "$INFO" ]] && break; sleep 0.1; done
    [[ -f "$INFO" ]] || { echo "failed to start, see $LOG"; exit 1; }
    cat "$INFO"; echo ;;
  stop)
    [[ -f "$INFO" ]] || { echo "not running"; exit 0; }
    kill "$(node -p "require('$INFO').pid")" 2>/dev/null || true
    for _ in $(seq 1 50); do [[ -f "$INFO" ]] || break; sleep 0.1; done
    rm -f "$INFO"; echo "stopped $TIE_INSTANCE" ;;
  status)
    [[ -f "$INFO" ]] && { cat "$INFO"; echo; } || echo "not running" ;;
  logs)
    if [[ "${1:-}" == "-f" ]]; then exec tail -f "$LOG"; else tail -n 100 "$LOG"; fi ;;
  test)
    case "${1:-}" in
      --unit) shift; exec npx vitest run "$@" ;;
      --e2e)
        if needs_build; then build; fi
        fail=0
        run="$RUNS/$(date +%Y%m%d-%H%M%S)-e2e"
        mkdir -p "$run"
        for s in dev/scenarios/*.mjs; do
          name="$(basename "$s" .mjs)"
          if TIE_RUN_DIR="$run/$name" node dev/drive.mjs "$s" >/dev/null 2>&1; then line="ok   $name"
          else line="FAIL $name ($run/$name/)"; fail=1; fi
          echo "$line" | tee -a "$run/summary.txt"
        done
        echo "trace: $run"
        exit $fail ;;
      *) echo "test --unit | --e2e"; exit 1 ;;
    esac ;;
  typecheck)
    exec npx tsc --noEmit -p tsconfig.json ;;
  layout)
    exec node dev/layout.mjs "$@" ;;
  screenshot)
    exec node dev/screenshot.mjs "$@" ;;
  drive)
    if [[ " $* " != *" --attach "* ]] && needs_build; then build; fi
    node dev/drive.mjs "$@" ;;
  package)
    fp="$(fingerprint)"
    version="$(node -p "require('./package.json').version")"
    if [[ "$(bundle_fp "$APP_OUT")" == "$fp" ]] && codesign -v "$APP_OUT" 2>/dev/null; then
      echo "$APP_OUT ($version, up to date)"; exit 0
    fi
    if pgrep -f "^$ROOT/$APP_OUT/Contents/MacOS/Tie" >/dev/null; then
      echo "Tie is running from $APP_OUT: quit it first (or run the installed copy)"; exit 1
    fi
    if needs_build; then build; fi
    rm -rf out/package
    mkdir -p out/package && echo "$fp" > out/package/fingerprint
    npx electron-builder --config electron-builder.yml >/dev/null
    codesign --force --deep --sign - "$APP_OUT" 2>/dev/null
    echo "$APP_OUT ($version)" ;;
  release)
    [[ "${1:-}" == "--version" && -n "${2:-}" ]] || { echo "usage: tie-dev release --version X.Y.Z"; exit 1; }
    want="$2"
    [[ "$want" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "version must be X.Y.Z"; exit 1; }
    [[ -z "$(git status --porcelain)" ]] || { echo "repo not clean:"; git status --short; exit 1; }
    have="$(node -p "require('./package.json').version")"
    # Resumable: tag already on HEAD with matching version = released; just make sure it's packaged.
    if git rev-parse -q --verify "refs/tags/v$want" >/dev/null; then
      if [[ "$(git rev-list -n1 "v$want")" == "$(git rev-parse HEAD)" && "$have" == "$want" ]]; then
        echo "v$want already tagged on HEAD"; "$0" package; echo "released v$want"; exit 0
      fi
      echo "tag v$want exists on another commit"; exit 1
    fi
    cmp="$(node -e "const [a,b]=process.argv.slice(1).map(v=>v.split('.').map(Number));const d=a.map((x,i)=>x-b[i]).find(x=>x!==0)||0;console.log(Math.sign(d))" "$want" "$have")"
    [[ "$cmp" != "-1" ]] || { echo "version $want is lower than current $have"; exit 1; }
    echo "checks..."
    "$0" typecheck && "$0" test --unit >/dev/null && echo "  typecheck, unit ok" || { echo "checks failed"; exit 1; }
    e2e="$("$0" test --e2e)" || { echo "$e2e"; echo "e2e failed"; exit 1; }
    echo "  e2e ok ($(grep -c '^ok' <<<"$e2e") scenarios)"
    if [[ "$cmp" == "1" ]]; then
      npm version "$want" --no-git-tag-version >/dev/null
      git add package.json package-lock.json
      git commit -qm "package: set version $want"
    fi
    git tag "v$want"
    "$0" package
    echo "released v$want" ;;
  install)
    dest="${TIE_INSTALL_DIR:-/Applications}/Tie.app"
    "$0" package >/dev/null
    if [[ -n "$(bundle_fp "$APP_OUT")" && "$(bundle_fp "$APP_OUT")" == "$(bundle_fp "$dest")" ]]; then
      echo "$dest up to date"; exit 0
    fi
    # Refuse only to replace the copy that is actually running.
    if pgrep -f "^$dest/Contents/MacOS/Tie" >/dev/null; then
      echo "Tie is running from $dest: quit it first (hold cmd+Q)"; exit 1
    fi
    rm -rf "$dest"
    ditto "$APP_OUT" "$dest"
    echo "installed $dest"
    echo "tie CLI outside Tie terminals: add /Applications/Tie.app/Contents/Resources/bin to PATH" ;;
  icon)
    node_modules/electron/dist/Electron.app/Contents/MacOS/Electron dev/icon.cjs -ApplePersistenceIgnoreState YES 2>/dev/null
    rm -rf tmp/icon.iconset && mkdir -p tmp/icon.iconset
    for s in 16 32 128 256 512; do
      sips -z $s $s build/icon.png --out "tmp/icon.iconset/icon_${s}x${s}.png" >/dev/null
      sips -z $((s*2)) $((s*2)) build/icon.png --out "tmp/icon.iconset/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns tmp/icon.iconset -o build/icon.icns
    echo "build/icon.png build/icon.icns" ;;
  scenarios)
    for s in dev/scenarios/*.mjs; do echo "$(basename "$s" .mjs)  $(head -1 "$s" | sed 's|^// *||')"; done ;;
  ""|-h|--help|help)
    usage ;;
  *)
    echo "unknown command: $cmd"; usage; exit 1 ;;
esac
