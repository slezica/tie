#!/usr/bin/env node
// tie: remote control for a running Tie instance (JSON-RPC over unix socket).
import { connect } from 'node:net'
import { homedir } from 'node:os'
import { join, resolve } from 'node:path'

const HELP = `tie - control Tie, the tiled workspace this shell runs in

USAGE
  tie list [--json]                       List tiles
  tie add|replace terminal [options]      Terminal tile, prints its id
  tie add|replace <file> [placement]      File in its viewer, prints its id
  tie add|replace <url> [placement]       http(s) URL in a browser tile, prints its id
  tie add|replace browser [url] [placement]
                                          Browser tile (empty: address field focused)
      add: the tile goes beside this terminal (or as placed below). replace: it takes this
      terminal's place, and the terminal closes once tie exits (see PLACEMENT, BEHAVIOR)
      --cmd <command>                     Run command instead of interactive shell
      --cwd <dir>                         Working directory (default: current)
      --title <text>                      Custom title
      --icon <emoji>                      Custom icon
      --at <id> [--side l|r|t|b]          add: split next to tile (default: caller/active, longer side)
      --float                             add: floating
      --shelved                           add: on the shelf (alias --shelve)
      --tab <tab|new>                     add: in another tab (see PLACEMENT)
      --focus                             Give the new tile keyboard input (default: input stays)
  tie close [--tile <id>]                 Close tile
  tie move [--tile <id>] --at <id> [--side l|r|t|b] | --float | --shelve (alias --shelved) [--focus]
  tie move [--tile <id>] --tab <tab|new> [--focus]
                                          Move tile to another tab
  tie move [--tile <id>] --swap <id> [--focus]
                                          Exchange places with another tile of the same tab
  tie focus [--tile <id>]                 Bring tile to user: switch tab, expand, take input
  tie ping [--tile <id>] [--clear]        Ask for attention: marks tile (and its tab) until it's active
  tie set [--tile <id>] [--title <text>] [--icon <emoji>]
                                          Set title and/or icon ("" = automatic)
      --tile <id>: the tile to act on (default: the tile this command runs in; see TILE IDS)

  Aliases: l list, a add, r replace, c close, m move, f focus, s set, p ping (tie a notes.md)

DESCRIPTION
  Tie is the user's full-screen workspace: tabs of tiles (terminals, file viewers, web pages) laid out
  side by side, floating, or parked on the shelf (an icon strip in the toolbar). Shells running in Tie can drive
  it with this command. Changes appear on the user's screen immediately.

  Use it to:
  - Show rich content: open a markdown file in a live viewer beside you. It re-renders whenever
    the file changes, so writing the file updates what the user sees.
  - Run something the user should watch or answer in its own terminal (servers, tests, prompts):
    tie add terminal --cmd "npm test".
  - Show a web page or a local dev server: tie add http://localhost:3000.
  - Ask for attention without interrupting: tie ping.
  - Keep the workspace tidy: label (set), move, shelve or close the tiles you added.
  - Turn this terminal into what it produced (a report, a page): tie replace report.md.

TILE KINDS
  terminal   Interactive shell (the user's login shell), or --cmd. A shell tile closes when its
             shell exits. A --cmd tile stays after the command ends and shows the exit status.
  markdown   Files .md, .markdown (tie add <file>). Rendered with headings, lists, tables,
             highlighted code, \`\`\`mermaid diagrams (flowchart, sequence, class, state, ER, gantt,
             pie, gitGraph), task boxes, footnotes, definition lists, :emoji: shortcodes; a
             leading --- front matter block is shown as-is (not parsed). Read-only: Tie never
             writes the file; task boxes (- [ ]) are display-only (edit the file to change them).
             - Live: re-renders on every save (any editor or tool). What the user is looking at
               stays still, even when text is added above; changed blocks get a margin mark
               (n in the tile jumps to the newest change).
               Deleted file: last view stays.
             - Raw HTML in the file is shown as text, never rendered.
             - Images: relative paths in the file's folder load; remote images are not loaded.
             - Links: relative .md opens in the same tile (cmd-click: new tile; cmd+[ / cmd+]
               back/forward); other local files open beside, in their kind (outside the file's
               folder: asks first); http(s) asks the
               user, then opens the system browser; other schemes are ignored. Hovering a
               link shows its target at the bottom of the tile.
             - A file that hangs or crashes the viewer leaves an error in the tile; reopen to retry.
  image      Files .png, .jpg, .jpeg, .gif, .webp, .avif, .svg, .ico, .bmp. Fit to the tile
             (shrink only); click or z toggles actual size. Reloads when the file changes. SVG is
             shown as an image: its scripts and links never run.
  html       Files .html, .htm: the file is the page, shown static: its own scripts never run
             (a red "Scripts blocked" tag in the title bar says when a page had some). CSS,
             images, fonts and links from its own folder work; no network at all, no access to
             Tie or other tiles. Reloads when a file in its folder changes (not subfolders;
             scroll kept). Links: html pages navigate the tile (cmd+[ / cmd+] back/forward);
             other files open beside, in their kind; web links ask the user first. The tile's
             title is the file name (never the page's <title>). For a dynamic page: run a
             server, open it in a browser tile.
  text       Any other file that is UTF-8 text (sniffed: no NUL bytes), whatever its name.
             Line numbers; code highlighted by extension (files up to 512 KB). Live like
             markdown (view stays still, changed lines marked, n jumps). Shown literally:
             HTML is text, control characters and bidi overrides are visible. Links don't open.
  hex        Any other file (binary): offset | bytes | ASCII. Live: changed rows highlighted.
  browser    Web pages: tie add <http(s) URL>, tie add browser [url] (a bare host[:port][/path]
             gets https://). A regular browser with the network, logins kept across restarts
             (shared by all browser tiles), no access to Tie, files or other tiles. Address bar:
             http(s) only, no search. Pages open in the tile; links that would open a new
             window ask the user, then open in the system browser.
             Downloads ask the user first, then save to ~/Downloads, never opened. Permissions
             (camera,
             notifications, location...) are denied. Not live: it doesn't watch files; reload
             (cmd+R) after rebuilding. Other schemes (file:, mailto:...) are refused.
  Size limits: markdown 8 MB, text 10 MB, html 10 MB, hex 16 MB, image 50 MB (larger: tie add
  fails).
  Folders can't be opened. File tiles never write files and never reach the network.

TILE IDS
  Random, like t7f2kqa: never reused, not even after Tie restarts. add (and every command acting
  on a tile) prints the id; --json prints full info. tie list shows all tiles, all tabs.
  close, move, focus, ping and set act on the tile this command runs in; --tile <id> names
  another. Outside a Tie terminal there is no such tile: --tile is required.
  Tabs: s plus 6 characters, like s4mq8xe (tie list --json: tabs, and each tile's tab); tie list's
  TAB column is the tab's position (1 = leftmost), also accepted by --tab.

PLACEMENT (add, move)
  Default: split next to the calling tile, along its longer side.
  --at <id> [--side l|r|t|b]  next to another tile (must be on the board, not shelved).
  --float                     floating over the board.
  --shelved                   on the shelf: an icon the user can hover to peek or click to open.
  --tab <tab|new>             in another tab: its id (s4mq8xe), its position (tie list's TAB column),
                              or new (a new tab after the user's). Beside that tab's active tile.
                              Not with --at, --side, --float, --shelved. The user's tab doesn't
                              change (unless --focus, or move takes the last tile of the tab on
                              screen: the user follows it). A tab left without tiles closes.
  --swap <id>                 (move) exchange places with another tile of the same tab: slots
                              (sizes stay with the places), floats, shelf. Other tab: error.
  replace                     no placement flags: the new tile takes the place of the terminal
                              this command runs in (same slot, float or shelf spot), and that
                              terminal closes once tie exits. The new tile gets input if the
                              terminal had it. Run it straight from the terminal's shell, with
                              nothing else running there (see BEHAVIOR). --focus is ok.

BEHAVIOR
  - add and move never take the user's keyboard input: typing stays where it was. --focus gives
    the tile input (only when the user expects it); with --tab or --swap it also shows the tile's
    tab. Empty board: the new tile gets input.
  - focus switches to the tile's tab, expands it, and gives it input. Use sparingly.
  - ping marks the tile (and its tab) with a dot until the user activates it. No focus change.
    Pinging the tile the user is already on does nothing.
  - replace fails, opening nothing, when: run outside a Tie terminal (no terminal to
    replace); tie runs under another program, not straight from the shell (tie runs under vim);
    the shell runs something else, background jobs included (A process is running: sleep).
    It closes the terminal without asking: the shell and its session end.
  - close kills a terminal's processes. The user can close or move your tiles at any time:
    re-check with tie list before acting on an old id.
  - Tiles persist until closed; Tie does not restore them after a restart.
  - Keys: cmd+[ / cmd+] back/forward, cmd+R reload, cmd+L address field (browser, file tiles)
    work while a page has focus; pages never see Tie's shortcuts.
  - Commands run from a Tie terminal (or anything it started) act as that terminal's tile, whatever
    TIE_TILE says. Other programs (scripts, other apps) are refused unless the user turns on
    Settings → Security → Allow external programs.

OUTPUT AND EXIT STATUS
  Plain output is the tile id (list: a table). --json prints JSON (list: tiles + tabs).
  Errors go to stderr with exit status 1: unknown id, no current tile (no --tile outside a Tie
  terminal), missing file, folder, file too large,
  not a web address (tie add browser <url>), no such tab, not in the same tab (--swap), replace
  refused or given placement (see BEHAVIOR), Tie not reachable, external control off.

ENVIRONMENT
  TIE_TILE      Id of the tile this shell runs in. Set by Tie. Tie checks it: the caller is the
                terminal the command runs in (process lineage), not this value.
  TIE_SOCKET    Control socket of the Tie instance this shell belongs to. Set by Tie.
  TIE_INSTANCE  Instance name (dev builds); outside Tie, selects which instance to control.

EXAMPLES
  tie add docs/plan.md                        Show a document beside this terminal
  tie add out/chart.png --float               Show an image (re-shown when rewritten)
  tie add report/index.html                   Show a local page (reloads when report/ changes)
  tie add http://localhost:5173 --shelved     Park a dev server's page on the shelf
  tie add terminal --cmd "npm run dev" --title dev --shelved
  tie add notes.md --tab new                  Show a document in a tab of its own
  tie move --tile t7f2kqa --tab 2             Send a tile to the second tab
  tie set --title "migrating db" --icon 🛠️     Label this tile
  tie ping                                    Done: ask the user to look here
  id=$(tie add report.md --float)             Later: tie close --tile $id
  tie replace notes.md                        Turn this terminal into the document`

const argv = process.argv.slice(2)
const flags = {}
const pos = []
const BOOL = new Set(['json', 'float', 'shelved', 'shelve', 'help', 'clear', 'focus'])
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]
  if (a === '-h') flags.help = true
  else if (a.startsWith('--')) {
    const k = a.slice(2)
    if (BOOL.has(k)) flags[k] = true
    else {
      if (i + 1 >= argv.length) die(`missing value for --${k}`)
      flags[k] = argv[++i]
    }
  } else pos.push(a)
}

function die(msg) {
  console.error(`tie: ${msg}`)
  process.exit(1)
}

const stateDir = join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), 'tie')
const socket = process.env.TIE_SOCKET || join(stateDir, `${process.env.TIE_INSTANCE || 'default'}.sock`)
const caller = process.env.TIE_TILE

// hold: keep the connection until this process exits (replace: Tie swaps the new tile in
// when it closes, after the caller's shell got the id; the kernel closes it at exit).
function call(method, params = {}, { hold = false } = {}) {
  return new Promise((resolve, reject) => {
    const c = connect(socket)
    let buf = ''
    c.on('error', (e) => reject(new Error(`cannot reach Tie at ${socket} (${e.code})`)))
    c.on('connect', () => c.write(JSON.stringify({ jsonrpc: '2.0', id: 1, method, params: { caller, ...params } }) + '\n'))
    c.on('data', (d) => {
      buf += d
      const nl = buf.indexOf('\n')
      if (nl < 0) return
      if (hold) c.unref()
      else c.end()
      const msg = JSON.parse(buf.slice(0, nl))
      if (msg.error) reject(new Error(msg.error.message))
      else resolve(msg.result)
    })
  })
}

const COMMANDS = ['list', 'add', 'replace', 'close', 'move', 'focus', 'set', 'ping']
// Single-letter aliases (first letters, unique). Option flags have none.
const ALIASES = Object.fromEntries(COMMANDS.map((c) => [c[0], c]))
// Per command: accepted options and max positional arguments. Anything else is refused.
const PLACE = ['at', 'side', 'float', 'shelve', 'shelved', 'tab', 'focus']
const OPEN = ['cmd', 'cwd', 'title', 'icon', 'id', ...PLACE] // id: dev builds only (not in HELP)
const SPEC = {
  list: { opts: [], args: 0 },
  add: { opts: OPEN, args: 2 },
  replace: { opts: OPEN, args: 2 },
  close: { opts: ['tile'], args: 0 },
  move: { opts: ['tile', 'swap', ...PLACE], args: 0 },
  focus: { opts: ['tile'], args: 0 },
  set: { opts: ['tile', 'title', 'icon'], args: 0 },
  ping: { opts: ['tile', 'clear'], args: 0 },
  frames: { opts: [], args: 0 },
  state: { opts: [], args: 0 },
}
function check(cmd, rest) {
  const spec = SPEC[cmd]
  if (!spec) return
  for (const k of Object.keys(flags)) if (!['json', 'help'].includes(k) && !spec.opts.includes(k)) die(`unknown option --${k} for ${cmd} (see tie --help)`)
  if (rest.length > spec.args) die(`unexpected argument: ${rest[spec.args]}`)
}
const pad = (s, n) => String(s).padEnd(n)
function printTile(t) {
  if (flags.json) console.log(JSON.stringify(t, null, 2))
  else console.log(t.id)
}

async function main() {
  const [given, ...rest] = pos
  if (!given || flags.help) return console.log(HELP)
  const cmd = ALIASES[given] ?? given
  check(cmd, rest)
  const id = flags.tile
  const place = { at: flags.at, side: flags.side, float: flags.float, shelve: flags.shelve, shelved: flags.shelved, tab: flags.tab, focus: flags.focus }

  switch (cmd) {
    case 'list': {
      const r = await call('list')
      if (flags.json) return console.log(JSON.stringify(r, null, 2))
      const tabIndex = Object.fromEntries(r.tabs.map((t, i) => [t.id, i + 1]))
      console.log(`${pad('ID', 8)} ${pad('TAB', 4)} ${pad('STATE', 9)} ${pad('FLAGS', 10)} TITLE`)
      for (const t of r.tiles) {
        const f = [t.active && 'active', t.pinged && 'pinged', t.collapsed && 'collapsed', t.zoomed && 'zoomed', t.pinned && 'pinned', t.exit !== null && `exit=${t.exit}`]
          .filter(Boolean)
          .join(',')
        console.log(`${pad(t.id, 8)} ${pad(tabIndex[t.tab] ?? '-', 4)} ${pad(t.state, 9)} ${pad(f || '-', 10)} ${t.icon ? t.icon + ' ' : ''}${t.title}`)
      }
      return
    }
    case 'add':
    case 'replace': {
      // An http(s) URL (browser), a kind name (browser takes a URL after it), else a file path
      // (resolved here, against the caller's cwd). replace: same params (placement refused by Tie).
      const replace = cmd === 'replace'
      const common = { cmd: flags.cmd, cwd: resolve(flags.cwd || '.'), title: flags.title, icon: flags.icon, as: flags.id, ...place }
      const open = (p) => call(cmd, { ...p, ...common }, { hold: replace })
      if (/^https?:\/\//i.test(rest[0] ?? '')) return printTile(await open({ url: rest[0] }))
      if (rest[0] === 'browser' && rest[1] !== undefined) return printTile(await open({ kind: 'browser', url: rest[1] }))
      if (rest.length > 1) die(`unexpected argument: ${rest[1]}`)
      const kind = rest[0] || 'terminal'
      const path = rest[0] ? resolve(rest[0]) : undefined
      return printTile(await open({ kind, path }))
    }
    case 'close':
      return void (await call('close', { id }))
    case 'move':
      return printTile(await call('move', { id, swap: flags.swap, ...place }))
    case 'ping':
      return printTile(await call('ping', { id, clear: flags.clear }))
    case 'focus':
      return printTile(await call('focus', { id }))
    case 'set':
      if (flags.title === undefined && flags.icon === undefined) die('set needs --title or --icon')
      return printTile(await call('set', { id, title: flags.title, icon: flags.icon }))
    case 'frames': // dev: window frame tree (url, origin, pid, out-of-process)
      return console.log(JSON.stringify(await call('frames'), null, 2))
    case 'state': // dev: internal state dump
      return console.log(JSON.stringify(await call('state'), null, 2))
    default:
      die(`unknown command: ${cmd} (commands: ${COMMANDS.join(', ')}; see tie --help)`)
  }
}

main().catch((e) => die(e.message))
