#!/usr/bin/env node
// tie: remote control for a running Tie instance (JSON-RPC over unix socket).
import { connect } from 'node:net'
import { homedir } from 'node:os'
import { join, resolve } from 'node:path'

const HELP = `tie - control Tie, the tiled workspace this shell runs in

USAGE
  tie list [--json]                       List tiles
  tie open terminal [options]             Open a terminal tile, prints its id
  tie open <file> [placement]             Open a file in its viewer, prints its id
  tie open <url> [placement]              Open an http(s) URL in a browser tile, prints its id
  tie open browser [url] [placement]      Open a browser tile (empty: address field focused)
      --cmd <command>                     Run command instead of interactive shell
      --cwd <dir>                         Working directory (default: current)
      --title <text>                      Custom title
      --at <id> [--side l|r|t|b]          Split next to tile (default: caller/active, longer side)
      --float                             Open floating
      --shelved                           Open on the shelf (alias --shelve)
      --focus                             Give the new tile keyboard input (default: input stays)
  tie close [id]                          Close tile
  tie move [id] --at <id> [--side l|r|t|b] | --float | --shelve (alias --shelved) [--focus]
  tie focus [id]                          Bring tile to user: switch tab, expand, take input
  tie ping [id] [--clear]                 Ask for attention: marks tile (and its tab) until it's active
  tie title [id] <text>                   Set title ("" = automatic)
  tie icon [id] <emoji>                   Set icon ("" = automatic)

DESCRIPTION
  Tie is the user's full-screen workspace: tabs of tiles (terminals, file viewers, web pages) laid out
  side by side, floating, or parked on a shelf at the right edge. Shells running in Tie can drive
  it with this command. Changes appear on the user's screen immediately.

  Use it to:
  - Show rich content: open a markdown file in a live viewer beside you. It re-renders whenever
    the file changes, so writing the file updates what the user sees.
  - Run something the user should watch or answer in its own terminal (servers, tests, prompts):
    tie open terminal --cmd "npm test".
  - Show a web page or a local dev server: tie open http://localhost:3000.
  - Ask for attention without interrupting: tie ping.
  - Keep the workspace tidy: title, move, shelve or close the tiles you opened.

TILE KINDS
  terminal   Interactive shell (the user's login shell), or --cmd. A shell tile closes when its
             shell exits. A --cmd tile stays after the command ends and shows the exit status.
  markdown   Files .md, .markdown (tie open <file>). Rendered with headings, lists, tables,
             highlighted code, \`\`\`mermaid diagrams (flowchart, sequence, class, state, ER, gantt,
             pie, gitGraph), task boxes, footnotes, definition lists, :emoji: shortcodes; a
             leading --- front matter block is shown as-is (not parsed). Read-only: Tie never
             writes the file; task boxes (- [ ]) are display-only (edit the file to change them).
             - Live: re-renders on every save (any editor or tool). What the user is looking at
               stays still, even when text is added above; changed blocks get a margin mark
               (n in the tile jumps to the newest change).
               Deleted file: last view stays.
             - Raw HTML in the file is shown as text, never rendered.
             - Images: relative paths in the file's folder load; remote images are not loaded.
             - Links: relative .md opens in the same tile (cmd-click: new tile; cmd+[ / cmd+]
               back/forward); other local files open beside, in their kind; http(s) asks the
               user, then opens the system browser; other schemes are ignored. Hovering a
               link shows its target at the bottom of the tile.
             - A file that hangs or crashes the viewer leaves an error in the tile; reopen to retry.
  image      Files .png, .jpg, .jpeg, .gif, .webp, .avif, .svg, .ico, .bmp. Fit to the tile
             (shrink only); click or z toggles actual size. Reloads when the file changes. SVG is
             shown as an image: its scripts and links never run.
  html       Files .html, .htm: the file is the page, shown static: its own scripts never run
             (a red "Scripts blocked" tag in the title bar says when a page had some). CSS,
             images, fonts and links from its own folder work; no network at all, no access to
             Tie or other tiles. Reloads when a file in its folder changes (not subfolders;
             scroll kept). Links: html pages navigate the tile (cmd+[ / cmd+] back/forward);
             other files open beside, in their kind; web links ask the user first. The tile's
             title is the file name (never the page's <title>). For a dynamic page: run a
             server, open it in a browser tile.
  text       Any other file that is UTF-8 text (sniffed: no NUL bytes), whatever its name.
             Line numbers; code highlighted by extension (files up to 512 KB). Live like
             markdown (view stays still, changed lines marked, n jumps). Shown literally:
             HTML is text, control characters and bidi overrides are visible. Links don't open.
  hex        Any other file (binary): offset | bytes | ASCII. Live: changed rows highlighted.
  browser    Web pages: tie open <http(s) URL>, tie open browser [url] (a bare host[:port][/path]
             gets https://). A regular browser with the network, logins kept across restarts
             (shared by all browser tiles), no access to Tie, files or other tiles. Address bar:
             http(s) only, no search. Pages open in the tile; links that would open a new
             window go to the system browser (only right after a click; scripts alone can't).
             Downloads ask the user first, then save to ~/Downloads, never opened. Permissions
             (camera,
             notifications, location...) are denied. Not live: it doesn't watch files; reload
             (cmd+R) after rebuilding. Other schemes (file:, mailto:...) are refused.
  Size limits: markdown 8 MB, text 10 MB, html 10 MB, hex 16 MB, image 50 MB (larger: tie open
  fails).
  Folders can't be opened. File tiles never write files and never reach the network.

TILE IDS
  t1, t2, ... open (and every command acting on a tile) prints the id; --json prints full info.
  [id] defaults to $TIE_TILE: the tile this command runs in. tie list shows all tiles, all tabs.

PLACEMENT (open, move)
  Default: split next to the calling tile, along its longer side.
  --at <id> [--side l|r|t|b]  next to another tile (must be on the board, not shelved).
  --float                     floating over the board.
  --shelved                   on the shelf: an icon the user can hover to peek or click to open.

BEHAVIOR
  - open and move never take the user's keyboard input: typing stays where it was. --focus gives
    the tile input (only when the user expects it). Empty board: the new tile gets input.
  - focus switches to the tile's tab, expands it, and gives it input. Use sparingly.
  - ping marks the tile (and its tab) with a dot until the user activates it. No focus change.
    Pinging the tile the user is already on does nothing.
  - close kills a terminal's processes. The user can close or move your tiles at any time:
    re-check with tie list before acting on an old id.
  - Tiles persist until closed; Tie does not restore them after a restart.
  - Keys: cmd+[ / cmd+] back/forward, cmd+R reload, cmd+L address field (browser, file tiles)
    work while a page has focus; pages never see Tie's shortcuts.
  - Commands run from a Tie terminal (or anything it started) act as that terminal's tile, whatever
    TIE_TILE says. Other programs (scripts, other apps) are refused unless the user turns on
    Settings → Security → Allow external programs.

OUTPUT AND EXIT STATUS
  Plain output is the tile id (list: a table). --json prints JSON (list: tiles + tabs).
  Errors go to stderr with exit status 1: unknown id, missing file, folder, file too large,
  not a web address (tie open browser <url>), Tie not reachable, external control off.

ENVIRONMENT
  TIE_TILE      Id of the tile this shell runs in. Set by Tie. Tie checks it: the caller is the
                terminal the command runs in (process lineage), not this value.
  TIE_SOCKET    Control socket of the Tie instance this shell belongs to. Set by Tie.
  TIE_INSTANCE  Instance name (dev builds); outside Tie, selects which instance to control.

EXAMPLES
  tie open docs/plan.md                       Show a document beside this terminal
  tie open out/chart.png --float              Show an image (re-shown when rewritten)
  tie open report/index.html                  Show a local page (reloads when report/ changes)
  tie open http://localhost:5173 --shelved    Park a dev server's page on the shelf
  tie open terminal --cmd "npm run dev" --title dev --shelved
  tie title "migrating db"; tie icon 🛠️        Label this tile
  tie ping                                    Done: ask the user to look here
  id=$(tie open report.md --float)            Later: tie close $id`

const argv = process.argv.slice(2)
const flags = {}
const pos = []
const BOOL = new Set(['json', 'float', 'shelved', 'shelve', 'help', 'clear', 'focus'])
for (let i = 0; i < argv.length; i++) {
  const a = argv[i]
  if (a === '-h') flags.help = true
  else if (a.startsWith('--')) {
    const k = a.slice(2)
    if (BOOL.has(k)) flags[k] = true
    else {
      if (i + 1 >= argv.length) die(`missing value for --${k}`)
      flags[k] = argv[++i]
    }
  } else pos.push(a)
}

function die(msg) {
  console.error(`tie: ${msg}`)
  process.exit(1)
}

const stateDir = join(process.env.XDG_CONFIG_HOME || join(homedir(), '.config'), 'tie')
const socket = process.env.TIE_SOCKET || join(stateDir, `${process.env.TIE_INSTANCE || 'default'}.sock`)
const caller = process.env.TIE_TILE

function call(method, params = {}) {
  return new Promise((resolve, reject) => {
    const c = connect(socket)
    let buf = ''
    c.on('error', (e) => reject(new Error(`cannot reach Tie at ${socket} (${e.code})`)))
    c.on('connect', () => c.write(JSON.stringify({ jsonrpc: '2.0', id: 1, method, params: { caller, ...params } }) + '\n'))
    c.on('data', (d) => {
      buf += d
      const nl = buf.indexOf('\n')
      if (nl < 0) return
      c.end()
      const msg = JSON.parse(buf.slice(0, nl))
      if (msg.error) reject(new Error(msg.error.message))
      else resolve(msg.result)
    })
  })
}

const pad = (s, n) => String(s).padEnd(n)
function printTile(t) {
  if (flags.json) console.log(JSON.stringify(t, null, 2))
  else console.log(t.id)
}

async function main() {
  const [cmd, ...rest] = pos
  if (!cmd || flags.help) return console.log(HELP)
  const place = { at: flags.at, side: flags.side, float: flags.float, shelve: flags.shelve, shelved: flags.shelved, focus: flags.focus }

  switch (cmd) {
    case 'list': {
      const r = await call('list')
      if (flags.json) return console.log(JSON.stringify(r, null, 2))
      const tabIndex = Object.fromEntries(r.tabs.map((t, i) => [t.id, i + 1]))
      console.log(`${pad('ID', 5)} ${pad('TAB', 4)} ${pad('STATE', 9)} ${pad('FLAGS', 10)} TITLE`)
      for (const t of r.tiles) {
        const f = [t.active && 'active', t.pinged && 'pinged', t.collapsed && 'collapsed', t.zoomed && 'zoomed', t.pinned && 'pinned', t.exit !== null && `exit=${t.exit}`]
          .filter(Boolean)
          .join(',')
        console.log(`${pad(t.id, 5)} ${pad(tabIndex[t.tab] ?? '-', 4)} ${pad(t.state, 9)} ${pad(f || '-', 10)} ${t.icon ? t.icon + ' ' : ''}${t.title}`)
      }
      return
    }
    case 'open': {
      // An http(s) URL (browser), a kind name (browser takes a URL after it), else a file path
      // (resolved here, against the caller's cwd).
      const common = { cmd: flags.cmd, cwd: resolve(flags.cwd || '.'), title: flags.title, ...place }
      if (/^https?:\/\//i.test(rest[0] ?? '')) return printTile(await call('open', { url: rest[0], ...common }))
      if (rest[0] === 'browser' && rest[1] !== undefined) return printTile(await call('open', { kind: 'browser', url: rest[1], ...common }))
      const kind = rest[0] || 'terminal'
      const path = rest[0] ? resolve(rest[0]) : undefined
      return printTile(await call('open', { kind, path, ...common }))
    }
    case 'close':
      return void (await call('close', { id: rest[0] }))
    case 'move':
      return printTile(await call('move', { id: rest[0], ...place }))
    case 'ping':
      return printTile(await call('ping', { id: rest[0], clear: flags.clear }))
    case 'focus':
      return printTile(await call('focus', { id: rest[0] }))
    case 'title':
    case 'icon': {
      // With 2+ args the first is the id; the rest is the value, unquoted words included.
      const [id, value] = rest.length >= 2 ? [rest[0], rest.slice(1).join(' ')] : [undefined, rest[0]]
      if (value === undefined) die(`${cmd} needs a value`)
      return printTile(await call(cmd, { id, text: value, emoji: value }))
    }
    case 'frames': // dev: window frame tree (url, origin, pid, out-of-process)
      return console.log(JSON.stringify(await call('frames'), null, 2))
    case 'state': // dev: internal state dump
      return console.log(JSON.stringify(await call('state'), null, 2))
    default:
      die(`unknown command: ${cmd} (see tie --help)`)
  }
}

main().catch((e) => die(e.message))
